#### 1. upload dish image
POST {{host}}/api/v1/files/upload?folder=dishes
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: Bearer {{admin_token}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test-dish.jpg"
Content-Type: image/jpeg

< ./test-dish.jpg

--WebAppBoundary--

> {%
 client.global.set("uploaded_image_url",response.body.data);
 client.log("Successfully fetch the image url: "+ client.global.get("uploaded_image_url"));
 %}

#### 2. create dish
POST {{host}}/api/v1/canteens/1/dishes
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Classic Irish Stew",
  "description": "Soft and flavorful, paired with mashed potatoes",
  "price": 12.5,
  "foodCategory": "MAIN",
  "available": true,
  "imageUrl": "{{uploaded_image_url}}"
}

#### 3. update dish
PUT {{host}}/api/v1/dishes/1
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Pizza",
  "description": "Soft and flavorful, paired with mashed potatoes",
  "price": 9.9,
  "foodCategory": "Pizza",
  "available": true
}

#### 4.get dish by id
GET {{host}}/api/v1/dishes/2

#### 5.get dishes
GET {{host}}/api/v1/canteens/1/dishes

#### 6.delete dish
DELETE {{host}}/api/v1/dishes/2
Authorization: Bearer {{admin_token}}

#### 7.verify soft delete - deleted dish should NOT appear in list
GET {{host}}/api/v1/canteens/1/dishes
Authorization: Bearer {{admin_token}}

#### 8. verify same-name dish can be recreated after soft delete
POST {{host}}/api/v1/canteens/1/dishes
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "name": "Classic Irish Stew",
  "description": "Recreated after soft delete",
  "price": 13.0,
  "foodCategory": "MAIN",
  "available": true
}

#### 9. count total dish amount
GET {{host}}/api/v1/dishes/count
Authorization: Bearer {{admin_token}}